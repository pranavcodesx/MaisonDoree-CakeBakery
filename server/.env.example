PORT=5000

# --- Database (pick ONE) ---------------------------------------------
# A) MongoDB installed on this computer:
MONGO_URI=mongodb://127.0.0.1:27017/maison_doree
# B) MongoDB Atlas (cloud). Paste the string from Atlas > Connect > Drivers.
#    Put the database name before the "?" and URL-encode special characters in the password.
# MONGO_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/maison_doree?retryWrites=true&w=majority

# Long random text used to sign login cookies. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-this-to-a-long-random-string

# Websites allowed to call this API (comma separated): website, admin panel.
CLIENT_ORIGINS=http://localhost:5173,http://localhost:5174

# Google sign-in ("Continue with Google" on the website). Leave empty to hide the button.
# Create the Client ID at console.cloud.google.com (steps in README.md > Google sign-in).
GOOGLE_CLIENT_ID=

# Forgot password: the server e-mails a reset link, so it needs an SMTP account.
# Leave empty while testing on your computer: the link is then printed in this server's window instead.
#   Gmail: SMTP_HOST=smtp.gmail.com  SMTP_PORT=587  SMTP_USER=you@gmail.com  SMTP_PASS=<16-letter App Password>
#   (Google Account > Security > 2-Step Verification ON > App passwords). Brevo / Resend / Zoho work the same way.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Maison Dorée <you@gmail.com>"
# Address of the website, used inside the reset e-mail. Default: the first address in CLIENT_ORIGINS.
# PUBLIC_URL=https://your-shop.onrender.com

# Real payments only (README → "Going live with real payments"): the secret you type when you create the webhook in Razorpay.
# RAZORPAY_WEBHOOK_SECRET=

# Razorpay keys (dashboard.razorpay.com > Settings > API Keys). Leave empty for Cash on Delivery only.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Set to "production" when you deploy (cookies become Secure and need HTTPS).
# NODE_ENV=production
